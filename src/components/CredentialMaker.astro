---
import { FORMAT_LIST } from "../lib/credential";
---

<div class="cred" data-credential>
  <div class="cred__form">
    <h1 class="cred__title">Tu credencial</h1>
    <p class="cred__lead">
      Subí tu foto, poné tu nombre y tu profesión. Se arma un pase con el diseño de Aleph, listo para historias, el feed de Instagram y X. La foto no sale de tu navegador.
    </p>

    <div class="cred-photo" data-photo-drop>
      <div class="cred-photo__frame" data-photo-preview aria-hidden="true"></div>
      <div class="cred-photo__copy">
        <label class="btn btn--ghost" for="cred-photo">Subir foto</label>
        <input
          id="cred-photo"
          class="cred-photo__input"
          type="file"
          accept="image/*"
          aria-describedby="cred-photo-hint cred-photo-error"
          autocomplete="off"
        />
        <p class="cred-photo__hint" id="cred-photo-hint">
          JPG, PNG o WEBP. Máximo 12&nbsp;MB.
        </p>
        <p class="cred-photo__error" id="cred-photo-error" hidden></p>
        <button class="cred-photo__clear" type="button" data-photo-clear hidden>
          Quitar foto
        </button>
      </div>
    </div>

    <div class="cred-field">
      <label for="cred-name">Nombre</label>
      <input
        id="cred-name"
        type="text"
        name="name"
        maxlength="48"
        autocomplete="name"
        placeholder="Ej. Ana Pérez"
        spellcheck="false"
      />
    </div>

    <div class="cred-field">
      <label for="cred-role">Profesión</label>
      <input
        id="cred-role"
        type="text"
        name="role"
        maxlength="40"
        autocomplete="organization-title"
        placeholder="Ej. Developer, Designer, Estudiante"
      />
    </div>
  </div>

  <div class="cred__stage">
    <fieldset class="cred-formats">
      <legend>Formato</legend>
      <div class="cred-formats__list">
        {
          FORMAT_LIST.map((format, index) => (
            <label class="cred-format">
              <input
                type="radio"
                name="cred-format"
                value={format.id}
                checked={index === 0}
              />
              <span class="cred-format__frame" style={`aspect-ratio: ${format.ratio}`}></span>
              <span class="cred-format__label">{format.label}</span>
              <span class="cred-format__hint">{format.pickerHint}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="cred-preview">
      <canvas data-cred-canvas width="1080" height="1920" aria-label="Vista previa de la credencial"></canvas>
      <p class="cred-preview__caption" data-cred-caption>Instagram Stories · 9:16</p>
    </div>

    <div class="cred-actions">
      <button class="btn btn--green" type="button" data-cred-download>
        Descargar PNG
      </button>
      <button class="btn btn--ghost" type="button" data-cred-share hidden>
        Compartir
      </button>
      <button class="btn btn--ghost" type="button" data-cred-copy>
        Copiar texto
      </button>
    </div>
    <p class="cred-status" data-cred-status role="status" aria-live="polite"></p>
    <p class="cred-note">
      Instagram y X no dejan publicar desde la web: descargá la imagen (o usá Compartir en el celular) y subila vos.
    </p>
  </div>
</div>

<script>
  import {
    FORMATS,
    SPONSOR_LOGOS,
    drawCredential,
    shareCaption,
    type FormatId,
  } from "../lib/credential";

  const root = document.querySelector("[data-credential]");
  if (root instanceof HTMLElement) {
    const canvas = root.querySelector("[data-cred-canvas]");
    const photoInput = root.querySelector<HTMLInputElement>("#cred-photo");
    const nameInput = root.querySelector<HTMLInputElement>("#cred-name");
    const roleInput = root.querySelector<HTMLInputElement>("#cred-role");
    const drop = root.querySelector("[data-photo-drop]");
    const preview = root.querySelector("[data-photo-preview]");
    const clearBtn = root.querySelector("[data-photo-clear]");
    const errorEl = root.querySelector("#cred-photo-error");
    const statusEl = root.querySelector("[data-cred-status]");
    const downloadBtn = root.querySelector("[data-cred-download]");
    const shareBtn = root.querySelector("[data-cred-share]");
    const copyBtn = root.querySelector("[data-cred-copy]");
    const caption = root.querySelector("[data-cred-caption]");
    const MAX_BYTES = 12 * 1024 * 1024;

    let sun: HTMLImageElement | null = null;
    let sponsors: { img: HTMLImageElement; round?: boolean }[] = [];
    let photo: ImageBitmap | HTMLImageElement | null = null;
    let photoUrl = "";
    let format: FormatId = "story";

    const setStatus = (text: string) => {
      if (statusEl) statusEl.textContent = text;
    };

    const setPhotoError = (text: string) => {
      if (!(errorEl instanceof HTMLElement)) return;
      errorEl.hidden = !text;
      errorEl.textContent = text;
      photoInput?.setAttribute("aria-invalid", text ? "true" : "false");
    };

    const currentFormat = (): FormatId => {
      const checked = root.querySelector<HTMLInputElement>("input[name='cred-format']:checked");
      const value = checked?.value;
      return value && value in FORMATS ? (value as FormatId) : "story";
    };

    const paint = async () => {
      if (!(canvas instanceof HTMLCanvasElement) || !sun) return;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;
      format = currentFormat();
      if (caption) caption.textContent = FORMATS[format].hint;
      await document.fonts.ready;
      drawCredential(ctx, format, {
        name: nameInput?.value ?? "",
        role: roleInput?.value ?? "",
        photo,
        sun,
        sponsors,
      });
    };

    const toBlob = () =>
      new Promise<Blob>((resolve, reject) => {
        if (!(canvas instanceof HTMLCanvasElement)) {
          reject(new Error("no canvas"));
          return;
        }
        canvas.toBlob((blob) => {
          if (blob) resolve(blob);
          else reject(new Error("png"));
        }, "image/png");
      });

    const loadPhoto = async (file: File) => {
      if (!file.type.startsWith("image/")) {
        setPhotoError("Eso no es una imagen. Probá con JPG o PNG.");
        return;
      }
      if (file.size > MAX_BYTES) {
        setPhotoError("La foto pesa más de 12 MB. Elegí una más liviana.");
        return;
      }
      setPhotoError("");
      try {
        if (photoUrl) URL.revokeObjectURL(photoUrl);
        photoUrl = URL.createObjectURL(file);
        let bitmap: ImageBitmap | HTMLImageElement;
        try {
          bitmap = await createImageBitmap(file);
        } catch {
          const img = new Image();
          img.src = photoUrl;
          await img.decode();
          bitmap = img;
        }
        if (photo && "close" in photo) photo.close();
        photo = bitmap;
        if (preview instanceof HTMLElement) {
          preview.style.backgroundImage = `url("${photoUrl}")`;
          preview.classList.add("has-photo");
        }
        if (clearBtn instanceof HTMLElement) clearBtn.hidden = false;
        await paint();
      } catch {
        setPhotoError("No se pudo leer esa foto. Probá con JPG o PNG.");
      }
    };

    const loadImg = (src: string) => {
      const img = new Image();
      img.src = src;
      return img.decode().then(() => img);
    };

    void Promise.all([
      loadImg("/logos/sun-white.svg"),
      ...SPONSOR_LOGOS.map((item) =>
        loadImg(item.src)
          .then((img) => ({ img, round: "round" in item && item.round }))
          .catch(() => null),
      ),
    ]).then(([sunImg, ...logos]) => {
      if (sunImg instanceof HTMLImageElement) sun = sunImg;
      sponsors = logos.filter((item): item is { img: HTMLImageElement; round?: boolean } => Boolean(item));
      return paint();
    });

    nameInput?.addEventListener("input", () => {
      void paint();
    });
    roleInput?.addEventListener("input", () => {
      void paint();
    });
    root.querySelectorAll<HTMLInputElement>("input[name='cred-format']").forEach((input) => {
      input.addEventListener("change", () => {
        void paint();
      });
    });

    photoInput?.addEventListener("change", () => {
      const file = photoInput.files?.[0];
      if (file) void loadPhoto(file);
    });

    if (drop instanceof HTMLElement) {
      drop.addEventListener("dragover", (event) => {
        event.preventDefault();
        drop.classList.add("is-over");
      });
      drop.addEventListener("dragleave", () => drop.classList.remove("is-over"));
      drop.addEventListener("drop", (event) => {
        event.preventDefault();
        drop.classList.remove("is-over");
        const file = event.dataTransfer?.files[0];
        if (file) void loadPhoto(file);
      });
    }

    clearBtn?.addEventListener("click", () => {
      if (photo && "close" in photo) photo.close();
      photo = null;
      if (photoUrl) URL.revokeObjectURL(photoUrl);
      photoUrl = "";
      if (preview instanceof HTMLElement) {
        preview.style.backgroundImage = "";
        preview.classList.remove("has-photo");
      }
      if (photoInput) photoInput.value = "";
      if (clearBtn instanceof HTMLElement) clearBtn.hidden = true;
      void paint();
    });

    downloadBtn?.addEventListener("click", async () => {
      try {
        await paint();
        const blob = await toBlob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = FORMATS[currentFormat()].file;
        a.click();
        URL.revokeObjectURL(url);
        setStatus("Listo, se descargó el PNG.");
      } catch {
        setStatus("No se pudo descargar. Probá de nuevo.");
      }
    });

    const canShare =
      typeof navigator.share === "function" &&
      typeof navigator.canShare === "function";

    if (shareBtn instanceof HTMLButtonElement && canShare) {
      shareBtn.hidden = false;
      shareBtn.addEventListener("click", async () => {
        try {
          await paint();
          const blob = await toBlob();
          const file = new File([blob], FORMATS[currentFormat()].file, { type: "image/png" });
          const text = shareCaption(nameInput?.value ?? "", roleInput?.value ?? "");
          if (!navigator.canShare({ files: [file] })) {
            setStatus("Este navegador no puede compartir el archivo. Descargá el PNG.");
            return;
          }
          await navigator.share({ files: [file], text, title: "Aleph Hackathon Salta" });
          setStatus("Compartido.");
        } catch (error) {
          if (error instanceof DOMException && error.name === "AbortError") return;
          setStatus("No se pudo compartir. Descargá el PNG y subilo a mano.");
        }
      });
    }

    copyBtn?.addEventListener("click", async () => {
      const text = shareCaption(nameInput?.value ?? "", roleInput?.value ?? "");
      try {
        await navigator.clipboard.writeText(text);
        setStatus("Texto copiado. Pegalo en la historia, el post o en X.");
      } catch {
        setStatus("No se pudo copiar. Seleccioná el texto a mano.");
      }
    });
  }
</script>
