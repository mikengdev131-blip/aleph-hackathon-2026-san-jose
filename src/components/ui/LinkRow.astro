---
interface Item {
  name: string;
  href: string;
  hint?: string;
}

interface Props {
  items: readonly Item[];
}

const { items } = Astro.props;
---

<div>
  {
    items.map((item) => (
      <a class="link-row" href={item.href} target="_blank" rel="noopener noreferrer">
        <span class="link-row__name">{item.name}</span>
        {item.hint && <span class="link-row__hint">{item.hint}</span>}
      </a>
    ))
  }
</div>
