---
interface Item {
  q: string;
  a: string;
}

interface Props {
  items: readonly Item[];
}

const { items } = Astro.props;
---

<div>
  {
    items.map((item) => (
      <details class="faq-item">
        <summary>{item.q}</summary>
        <p class="faq-item__answer">{item.a}</p>
      </details>
    ))
  }
</div>
