---
import { links, venue } from "../../content/site";
import Section from "../ui/Section.astro";
import Callout from "../ui/Callout.astro";
import Button from "../ui/Button.astro";
import CopyAddress from "../CopyAddress.astro";
---

<Section id="lugar" title="Sábado IRL, domingo online">
  <div class="split">
    <div class="prose-block">
      <h3 class="timeline__heading">Sábado 22 · presencial en San José</h3>
      <p>
        Opening, armado de equipos y el día entero hackeando juntos en la sede. Arrancamos a las 9:00 y hay desayuno, almuerzo y coffee break.
      </p>
      <p>
        <strong class="place-name">📍 Ubicación — {venue.name}</strong><br />
        {venue.line1}<br />
        {venue.city}
      </p>
      <p class="actions mt-16">
        <Button href={links.maps} variant="primary" external>Ver en Maps</Button>
        <CopyAddress text={venue.copyText} />
      </p>
    </div>
    <div class="prose-block">
      <h3 class="timeline__heading">Domingo 23 · 100% online</h3>
      <p>
        No hay actividad presencial el domingo. Seguís el proyecto desde donde estés, subís el proyecto y el jurado lo revisa de manera remota.
      </p>
      <Callout tone="warn" title="El domingo la comida corre por tu cuenta: es 100% online" />
    </div>
  </div>
</Section>
