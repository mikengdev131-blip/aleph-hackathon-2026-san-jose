---
import { organizers } from "../../content/site";
import Section from "../ui/Section.astro";
import SocialIcons from "../SocialIcons.astro";
---

<Section id="organizadores" title="Co-organizadores">
  <p class="section__lead mb-24">
    Co-organizado por Zeek, Sebastián Ceciliano, Michael Sibaja, Fabián Sánchez, Emilio Alfaro y Tamara Ortega. Si hay un problema el sábado, acercate a cualquiera de nosotros.
  </p>
  <div class="org-list">
    {
      organizers.map((org) => (
        <div class="org-item">
          {org.logo && (
            <img
              class={org.round ? "org-item__mark is-round" : "org-item__mark"}
              src={org.logo}
              alt=""
              width={org.logoWidth}
              height={org.logoHeight}
              loading="lazy"
              decoding="async"
            />
          )}
          <div>
            <strong>{org.name}</strong>
            <span>{org.role}</span>
          </div>
          <SocialIcons links={org.socials} />
        </div>
      ))
    }
  </div>
</Section>
